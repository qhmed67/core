#!/bin/sh
# core-managed-hook
# Reject attribution and message-quality problems before a commit is created.
# Enforced here: AI attribution, empty or vague subjects, subjects over 72.
# Not enforced here: Conventional Commits. Other repositories may have their
# own style; the git-discipline skill covers format.
set -u

msg_file=${1:-}

if [ -z "$msg_file" ] || [ ! -f "$msg_file" ]; then
  printf '%s\n' "commit-msg: missing commit message file" >&2
  exit 1
fi

# Read the message without comment lines. Git uses the first non-comment,
# non-blank line as the subject.
subject=$(sed -e '/^#/d' -e '/^[[:space:]]*$/d' "$msg_file" | sed -n '1p' | tr -d '\r')

if [ -z "$subject" ]; then
  printf '%s\n' "commit-msg: empty commit message" >&2
  exit 1
fi

# Attribution check covers the whole message, including footers.
if grep -iE '^[[:space:]]*(co-authored-by|generated-by|assisted-by|code-author)[[:space:]]*:' "$msg_file" >/dev/null 2>&1; then
  printf '%s\n' "commit-msg: attribution trailers are not allowed" >&2
  exit 1
fi

if grep -iE '(generated|written|created|made)[[:space:]]+(with|by)[[:space:]]+(claude|chatgpt|gpt|openai|anthropic|copilot|cursor|codex|gemini|deepseek|llama|mistral|grok|qwen|kimi|glm|ai|an[[:space:]]+ai)\b|ai[- ]generated|this[[:space:]]+commit[[:space:]]+was[[:space:]]+(generated|written)[[:space:]]+by' "$msg_file" >/dev/null 2>&1; then
  printf '%s\n' "commit-msg: AI attribution phrases are not allowed" >&2
  exit 1
fi

# Robot emoji, encoded as UTF-8 bytes so the check works without a UTF-8 locale.
if grep -F '🤖' "$msg_file" >/dev/null 2>&1; then
  printf '%s\n' "commit-msg: robot emoji is not allowed in commit messages" >&2
  exit 1
fi

# Merge, revert and autosquash subjects are generated by git or by tooling.
case "$subject" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *)
    exit 0
    ;;
esac

length=$(printf '%s' "$subject" | LC_ALL=C awk '{ print length($0) }')
if [ "$length" -gt 72 ]; then
  printf '%s\n' "commit-msg: subject is $length characters; keep it at 72 or fewer" >&2
  exit 1
fi

# Compare the descriptive part, not the type prefix. "docs: update" is still
# vague; "docs: explain Claude Code setup" is not.
lower=$(printf '%s' "$subject" | tr '[:upper:]' '[:lower:]')
core=$(printf '%s' "$lower" | sed -E 's/^[a-z]+(\([^)]*\))?!?:[[:space:]]*//')

case "$core" in
  update|updates|fix|fixes|fixed|change|changes|wip|misc|stuff|minor|tweaks|cleanup|clean\ up|fix\ stuff|some\ changes|minor\ changes|minor\ fixes|various\ changes|improvements|bugfix|bug\ fix)
    printf '%s\n' "commit-msg: vague subject; say what changed and why" >&2
    exit 1
    ;;
esac

exit 0
