#!/bin/sh
# core-managed-hook
# Reject attribution and message-quality problems before a commit is created.
# Enforced here: AI attribution, empty or vague subjects, filler words, subjects
# over 72, long bodies, Conventional Commits (CORE_REQUIRE_CONVENTIONAL),
# commit size limits.
set -u

msg_file=${1:-}

hook_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ -f "$hook_dir/core-identity" ]; then
  . "$hook_dir/core-identity"
elif root=$(git rev-parse --show-toplevel 2>/dev/null) && [ -f "$root/githooks/identity" ]; then
  . "$root/githooks/identity"
fi
: "${CORE_REQUIRE_CONVENTIONAL:=1}"
: "${CORE_MAX_COMMIT_FILES:=15}"
: "${CORE_MAX_COMMIT_LINES:=500}"
: "${CORE_MAX_BODY_LINES:=12}"
: "${CORE_BANNED_WORDS:=comprehensive|robust|seamless(ly)?|leverag(e|es|ed|ing)|utiliz(e|es|ed|ing)|streamlin(e|es|ed|ing)|holistic(ally)?|delv(e|es|ed|ing)|elevat(e|es|ed|ing)}"

if [ -z "$msg_file" ] || [ ! -f "$msg_file" ]; then
  printf '%s\n' "commit-msg: missing commit message file" >&2
  exit 1
fi

# Read the message without comment lines. Git uses the first non-comment,
# non-blank line as the subject.
subject=$(sed -e '/^#/d' -e '/^[[:space:]]*$/d' "$msg_file" | sed -n '1p' | tr -d '\r')

if [ -z "$subject" ]; then
  printf '%s\n' "commit-msg: empty commit message" >&2
  exit 1
fi

# Attribution check covers the whole message, including footers.
if grep -iE '^[[:space:]]*(co-authored-by|generated-by|assisted-by|code-author)[[:space:]]*:' "$msg_file" >/dev/null 2>&1; then
  printf '%s\n' "commit-msg: attribution trailers are not allowed" >&2
  exit 1
fi

if grep -iE '(generated|written|created|made)[[:space:]]+(with|by)[[:space:]]+(claude|chatgpt|gpt|openai|anthropic|copilot|cursor|codex|gemini|deepseek|llama|mistral|grok|qwen|kimi|glm|ai|an[[:space:]]+ai)\b|ai[- ]generated|this[[:space:]]+commit[[:space:]]+was[[:space:]]+(generated|written)[[:space:]]+by' "$msg_file" >/dev/null 2>&1; then
  printf '%s\n' "commit-msg: AI attribution phrases are not allowed" >&2
  exit 1
fi

# Robot emoji, encoded as UTF-8 bytes so the check works without a UTF-8 locale.
if grep -F '🤖' "$msg_file" >/dev/null 2>&1; then
  printf '%s\n' "commit-msg: robot emoji is not allowed in commit messages" >&2
  exit 1
fi

# Merge, revert and autosquash subjects are generated by git or by tooling.
case "$subject" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *)
    exit 0
    ;;
esac

length=$(printf '%s' "$subject" | LC_ALL=C awk '{ print length($0) }')
if [ "$length" -gt 72 ]; then
  printf '%s\n' "commit-msg: subject is $length characters; keep it at 72 or fewer" >&2
  exit 1
fi

# Conventional Commits: type(scope)!: subject.
if [ "$CORE_REQUIRE_CONVENTIONAL" = "1" ]; then
  if ! printf '%s' "$subject" | grep -Eq '^(feat|fix|docs|style|refactor|test|perf|build|ci|chore|revert)(\([A-Za-z0-9._/-]+\))?!?: [^ ]'; then
    printf '%s\n' "commit-msg: subject must look like 'type(scope): subject' (feat, fix, docs, style, refactor, test, perf, build, ci, chore, revert)" >&2
    exit 1
  fi
fi

# Compare the descriptive part, not the type prefix. "docs: update" is still
# vague; "docs: explain Claude Code setup" is not.
lower=$(printf '%s' "$subject" | tr '[:upper:]' '[:lower:]')
core=$(printf '%s' "$lower" | sed -E 's/^[a-z]+(\([^)]*\))?!?:[[:space:]]*//')

case "$core" in
  update|updates|fix|fixes|fixed|change|changes|wip|misc|stuff|minor|tweaks|cleanup|clean\ up|fix\ stuff|some\ changes|minor\ changes|minor\ fixes|various\ changes|improvements|bugfix|bug\ fix)
    printf '%s\n' "commit-msg: vague subject; say what changed and why" >&2
    exit 1
    ;;
esac

# Style. The body stays short and free of filler words. A verbose editor
# template (commit -v) appends a diff after a scissors line; cut it first.
text=$(sed -e '/^# -* >8 -*$/,$d' -e '/^#/d' -e '/^[[:space:]]*$/d' "$msg_file")

if printf '%s\n' "$text" | grep -Eiq "(^|[^[:alnum:]_])($CORE_BANNED_WORDS)([^[:alnum:]_]|$)"; then
  printf '%s\n' "commit-msg: filler words are not allowed (see CORE_BANNED_WORDS); say what changed instead" >&2
  exit 1
fi

body_lines=$(printf '%s\n' "$text" | wc -l | tr -d ' ')
body_lines=$((body_lines - 1))
if [ "$body_lines" -gt "$CORE_MAX_BODY_LINES" ]; then
  printf 'commit-msg: body is %s lines; keep it at %s or fewer. Say why, not how.\n' "$body_lines" "$CORE_MAX_BODY_LINES" >&2
  exit 1
fi

# Commit size. Staged diff only. Binary files count as files, not lines.
if [ "${CORE_ALLOW_LARGE:-}" != "1" ]; then
  stats=$(git diff --cached --numstat 2>/dev/null || true)
  files=$(printf '%s\n' "$stats" | sed '/^$/d' | wc -l | tr -d ' ')
  lines=$(printf '%s\n' "$stats" | awk '$1 ~ /^[0-9]+$/ && $2 ~ /^[0-9]+$/ { s += $1 + $2 } END { print s + 0 }')
  if [ "$files" -gt "$CORE_MAX_COMMIT_FILES" ] || [ "$lines" -gt "$CORE_MAX_COMMIT_LINES" ]; then
    printf 'commit-msg: commit too large (%s files, %s changed lines; limit %s files, %s lines). Split it into logical commits.\n' \
      "$files" "$lines" "$CORE_MAX_COMMIT_FILES" "$CORE_MAX_COMMIT_LINES" >&2
    exit 1
  fi
fi

exit 0
